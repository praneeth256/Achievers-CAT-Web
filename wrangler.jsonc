{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "achievers-cat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (Next.js public/ + built _next/ chunks)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ── Non-secret environment variables ─────────────────────────────────────
  // Secrets (FIREBASE_ADMIN_*, GMAIL_*, CRON_SECRET) stay in the dashboard.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://achievers-cat.catprep.workers.dev"
  },

  // ── Cron Triggers ─────────────────────────────────────────────────────────
  // Replaces Vercel Cron. Fires the daily-email route at 07:00 AM IST (01:30 UTC).
  // The route authenticates via the CRON_SECRET env var — same as before.
  "triggers": {
    "crons": ["30 1 * * *"]
  }

  // ── Uncomment if you add ISR / tag-based caching later ───────────────────
  // "kv_namespaces": [{ "binding": "NEXT_CACHE_WORKERS_KV", "id": "<KV_ID>" }],
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "achievers-cat-cache" }]
}
