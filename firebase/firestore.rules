rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // HELPER FUNCTIONS
    // --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // --------------------------------------------------
    // PROFILES
    // --------------------------------------------------

    match /profiles/{uid} {

      // Display names power the public streak leaderboard. The profile
      // document remains the source of truth for existing student labels.
      allow read: if true;

      allow create:
        if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role']);

      allow update:
        if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(['role'])
        );

      allow delete:
        if isAdmin();
    }

    match /materials/{materialId} {
      allow read:
        if resource.data.published == true || isAdmin();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MOCKS
    // --------------------------------------------------

    match /mocks/{mockId} {

      allow read:
        if resource.data.status == 'published' || isAdmin();

      allow create, update, delete:
        if isAdmin();
    }


    match /question_assets/{assetId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    match /mock_file_chunks/{chunkId} {

      allow read:
        if signedIn()
        && get(
          /databases/$(database)/documents/mocks/$(resource.data.mockId)
        ).data.status == 'published';

      allow create, update, delete:
        if isAdmin();
    }


    match /mock_sections/{id} {

      allow read:
        if signedIn()
        && (
          isAdmin()
          ||
          get(
            /databases/$(database)/documents/mocks/$(resource.data.mockId)
          ).data.status == 'published'
        );

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // QUESTIONS
    // --------------------------------------------------

    match /questions/{questionId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    // Chapter-wise practice questions. Students can only receive questions
    // that an admin has explicitly published.
    match /practice_questions/{questionId} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // A group stores one shared RC passage or DILR set with its four linked
    // questions. It follows the same publishing permissions as standalone
    // practice questions.
    match /practice_groups/{groupId} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }


    match /question_options/{optionId} {

      // Correct answers remain admin-only.
      allow read, create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY CONTENT
    // --------------------------------------------------

    match /daily_packages/{date} {

      allow read:
        if resource.data.published != false || isAdmin();

      allow create, update, delete:
        if isAdmin();
    }

    match /daily_reads/{readId} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }


    match /daily_questions/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    match /daily_rcs/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // USER STREAKS
    // --------------------------------------------------

    // One document per student. A streak is updated when a
    // Daily Practice section is successfully submitted.
    match /user_streaks/{uid} {

      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.currentStreak is number
        && request.resource.data.longestStreak is number
        && request.resource.data.lastActivityDate is string;

      allow update: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.currentStreak is number
        && request.resource.data.longestStreak is number
        && request.resource.data.lastActivityDate is string;

      allow delete: if isAdmin();
    }


    // --------------------------------------------------
    // DAILY SECTION STATS
    // --------------------------------------------------

    match /daily_section_stats/{id} {

      allow read:
        if true;


      // Student can create the counter
      // when the first person attempts.
      allow create:
        if signedIn()
        && request.resource.data.count == 1
        && request.resource.data.date is string
        && request.resource.data.section
          in ['quant', 'varc', 'dilr'];


      // Student can increment the counter
      // by exactly one.
      allow update:
        if signedIn()
        && request.resource.data.count ==
          resource.data.count + 1
        && request.resource.data.date ==
          resource.data.date
        && request.resource.data.section ==
          resource.data.section;


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY ATTEMPTS
    // --------------------------------------------------

    match /daily_attempts/{id} {

      // Students can see their own attempt.
      // Admin can see all attempts.
      allow read:
        if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );


      // Student can create their own attempt.
      allow create:
        if signedIn()
        && request.resource.data.userId ==
          request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.section
          in ['quant', 'varc', 'dilr']
        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.wrong is number
        && request.resource.data.total is number;


      // Student can update only their own attempt.
      allow update:
        if signedIn()
        && (
          isAdmin()
          ||
          (
            resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.date ==
              resource.data.date
            &&
            request.resource.data.section ==
              resource.data.section
          )
        );


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY LEADERBOARDS
    //
    // IMPORTANT:
    //
    // Correct structure:
    //
    // daily_leaderboards
    //   /2026-08-27_quant
    //      /entries
    //         /USER_UID
    //
    // This avoids the invalid collection path:
    //
    // daily_leaderboards/2026-08-27/quant/entries
    // --------------------------------------------------

    match /daily_leaderboards/{leaderboardId}/entries/{uid} {

      // Live rankings are intentionally public so visitors can
      // see today's leaderboard without signing in.
      allow read:
        if true;


      // Student can create ONLY their own entry.
      //
      // The leaderboard entry must match the daily attempt
      // created in the SAME transaction.
      allow create:
        if signedIn()
        && uid == request.auth.uid

        && request.resource.data.userId ==
          request.auth.uid

        && request.resource.data.date is string

        && request.resource.data.section
          in ['quant', 'varc', 'dilr']

        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.wrong is number
        && request.resource.data.total is number

        && leaderboardId ==
          request.resource.data.date + '_' +
          request.resource.data.section

        && request.resource.data.date ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.date

        && request.resource.data.section ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.section

        && request.resource.data.score ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.score

        && request.resource.data.correct ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.correct

        && request.resource.data.wrong ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.wrong

        && request.resource.data.total ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.total;


      // A student's leaderboard entry may be refreshed when a new
      // submission is being saved. It must still belong to that student
      // and must exactly match the attempt written in the same transaction.
      allow update:
        if signedIn()
        && uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.section in ['quant', 'varc', 'dilr']
        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.wrong is number
        && request.resource.data.total is number
        && leaderboardId ==
          request.resource.data.date + '_' +
          request.resource.data.section
        && request.resource.data.date ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.date
        && request.resource.data.section ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.section
        && request.resource.data.score ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.score
        && request.resource.data.correct ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.correct
        && request.resource.data.wrong ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.wrong
        && request.resource.data.total ==
          getAfter(
            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)
          ).data.total;

      allow delete:
        if isAdmin();
    }

    // Platform announcements are created by admins and visible to every
    // signed-in student in the notification bell.
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // --------------------------------------------------
    // GENERAL ATTEMPTS
    // --------------------------------------------------

    match /attempts/{attemptId} {

      allow read:
        if signedIn()
        && (
          // The app checks this deterministic document before a first
          // attempt exists, so resource.data is unavailable at that point.
          attemptId.matches('^' + request.auth.uid + '_.*')
          || resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create:
        if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.mockId is string
        && attemptId == request.auth.uid + '_' + request.resource.data.mockId
        && request.resource.data.status == 'in_progress';

      allow update:
        if signedIn()
        && (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.mockId == resource.data.mockId
          && resource.data.status == 'in_progress'
          && request.resource.data.status == 'submitted'
          || isAdmin()
        );

      allow delete:
        if isAdmin();
    }

    // Public, answer-free rows used only for ranking. Answers remain private
    // in /attempts, so a percentile never exposes a student's responses.
    match /mock_rankings/{rankingId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && rankingId == request.auth.uid + '_' + request.resource.data.mockId;
      allow delete: if isAdmin();
    }


    // --------------------------------------------------
    // ATTEMPT ANSWERS
    // --------------------------------------------------

    match /attempt_answers/{answerId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );

      allow create:
        if signedIn()
        && request.resource.data.userId ==
          request.auth.uid;

      allow update:
        if signedIn()
        && (
          isAdmin()
          ||
          (
            resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.userId ==
              request.auth.uid
          )
        );

      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // RESULTS
    // --------------------------------------------------

    match /results/{resultId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );

      // Results remain admin/server controlled.
      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MATERIAL CATEGORIES
    // --------------------------------------------------

    match /material_categories/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MATERIALS
    // --------------------------------------------------

    match /materials/{id} {

      allow read:
        if signedIn()
        && (
          resource.data.published == true
          || isAdmin()
        );

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // ADMIN LOGS
    // --------------------------------------------------

    match /admin_logs/{id} {

      allow read, create, update, delete:
        if isAdmin();
    }
  }
}
